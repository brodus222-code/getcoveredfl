{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Post title"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug for the post"
    },
    "excerpt": {
      "type": "string",
      "description": "Short summary shown on the blog listing"
    },
    "meta_description": {
      "type": "string",
      "description": "SEO meta description for search engines (under 160 chars)"
    },
    "focus_keyword": {
      "type": "string",
      "description": "Primary SEO keyword the post targets"
    },
    "content": {
      "type": "string",
      "description": "Full post body in markdown"
    },
    "faq_content": {
      "type": "string",
      "description": "FAQ section in markdown \u2014 powers FAQ schema for Google featured snippets"
    },
    "category": {
      "type": "string",
      "enum": [
        "open_enrollment",
        "new_options",
        "deadlines",
        "tips",
        "general"
      ],
      "default": "general",
      "description": "Post category"
    },
    "author": {
      "type": "string",
      "description": "Author name"
    },
    "published_date": {
      "type": "string",
      "format": "date",
      "description": "Publication date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "published",
      "description": "Publication status"
    }
  },
  "required": [
    "title",
    "slug",
    "excerpt",
    "content",
    "published_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}