{
  "name": "Lead",
  "type": "object",
  "properties": {
    "zip_code": {
      "type": "string",
      "description": "ZIP code for coverage area"
    },
    "household_size": {
      "type": "number",
      "description": "Number of people in household"
    },
    "coverage_members": {
      "type": "string",
      "enum": [
        "just_me",
        "me_spouse",
        "me_kids",
        "whole_family"
      ],
      "description": "Who in the household needs coverage"
    },
    "ages": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Ages of household members"
    },
    "estimated_income": {
      "type": "number",
      "description": "Estimated annual household income"
    },
    "start_coverage": {
      "type": "string",
      "enum": [
        "asap",
        "few_weeks",
        "not_sure"
      ],
      "description": "When the lead hopes to start coverage"
    },
    "lead_reason": {
      "type": "string",
      "enum": [
        "lost_coverage",
        "job_change",
        "moved",
        "family_changes",
        "none"
      ],
      "description": "What brought the lead to seek coverage"
    },
    "coverage_type": {
      "type": "string",
      "enum": [
        "aca_marketplace",
        "cobra_alternatives",
        "short_term_gap",
        "first_time_coverage",
        "ppo_broad_network",
        "most_affordable",
        "callback_request"
      ],
      "description": "Type of coverage interested in"
    },
    "currently_insured": {
      "type": "boolean",
      "description": "Whether currently insured"
    },
    "takes_prescriptions": {
      "type": "boolean",
      "description": "Whether takes regular prescriptions"
    },
    "prefers_specific_network": {
      "type": "boolean",
      "description": "Whether prefers specific doctor/hospital network"
    },
    "full_name": {
      "type": "string",
      "description": "Contact full name"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "email": {
      "type": "string",
      "description": "Contact email address"
    },
    "sms_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Whether the lead opted in to receive SMS updates about their quote"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "quoted",
        "enrolled",
        "closed"
      ],
      "default": "new",
      "description": "Lead status"
    },
    "assigned_agent_email": {
      "type": "string",
      "description": "Email of the agent assigned to this lead"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about the lead"
    },
    "confirmation_email_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the branded confirmation email has been sent to this lead"
    },
    "lead_source": {
      "type": "string",
      "enum": [
        "website",
        "meta_instant_form",
        "other"
      ],
      "default": "website",
      "description": "Where the lead came from"
    },
    "birth_year": {
      "type": "number",
      "description": "Birth year reported on the lead form, used for age qualification"
    },
    "qualified": {
      "type": "boolean",
      "default": true,
      "description": "False when the lead fails age qualification (Medicare-age) and should not be routed to an agent"
    },
    "disqualified_reason": {
      "type": "string",
      "description": "Why the lead was marked unqualified"
    }
  },
  "required": [
    "zip_code",
    "full_name",
    "phone",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.assigned_agent_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_agent_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}