{
  "name": "Auto-Generate SEO Blog Posts",
  "description": "Generates and auto-publishes an SEO-optimized Florida health insurance blog post every 3 days at 9am ET using Claude Sonnet for top-quality long-form content with FAQ schema and keyword targeting.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": 3,
      "interval_unit": "days",
      "interval_anchor": "2026-10-17T13:00:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_seo_blog_post",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_post": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateSeoBlogPost",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Generate SEO blog post",
            "description": "AI-generated Florida health insurance content"
          }
        }
      }
    ]
  }
}