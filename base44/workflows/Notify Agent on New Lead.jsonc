{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_agent_on_new_lead",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyAgentNewLead",
            "args": {
              "lead_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify agent",
            "description": "Email lead details to agency inbox"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": "${ .trigger.data.qualified != false }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Lead"
    }
  },
  "name": "Notify Agent on New Lead",
  "description": ""
}